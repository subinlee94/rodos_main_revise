<?xml version="1.0" encoding="UTF-8"?>
<Module type ="SIM">
  <!-- General Information -->
    <moduleName>Navigation_Module</moduleName>
    <description>Information model for ROS2 Navigation2 BT Navigator module providing high-level navigation orchestration using Behavior Trees keyword : patrol explore move</description>
    <manufacturer>Open Robotics</manufacturer>
    <examples>
      The navigate_to_pose action is called when moving to a single target pose, 
      and the navigate_through_poses action is called when passing through multiple waypoints or moving sequentially. 
      This action also allows the robot to patrol around the map. 
      Patrols the waypointsof the map through the navigate_through_poses action. 
    </examples>
    <idnType type="Bas">
      <moduleID>
        <mID>68451959d205584aa3da384997e263120032A3C800000000000000008C5000</mID>
        <iID>00</iID>
      </moduleID>
      <informationModelVersion>1.0</informationModelVersion>
    </idnType>
  <!-- Module Properties -->
  <properties>
		<osType type="Ubuntu" bit="BIT64" version="22.04"/>
		<compilerType>
			<osName>Ubuntu</osName>
			<verRangeOS min="22.04" max="22.04"/>
			<compilerName>GCC</compilerName>
			<verRangeCompiler min="11.3.0" max="Higher"/>
			<bitnCPUarch bit="32" CPUarch="armv7hf"/>
		</compilerType>
		<exeType>
			<Item>
				<opType>EventDriven</opType>
				<priority>1</priority>
				<hardRT>false</hardRT>
				<timeConstraint> 10000 </timeConstraint>
				<instanceType> Singleton </instanceType>
			</Item>		
    </exeType>
		<organization>
      <owner>
        <moduleID>  <!-- HW/SW IM : raspberry pi-->
          <mID>3436bec64aff597a85dbbfdad0ce251658ffbbaaffabfaff1e0f4000401000</mID>
          <iID>00</iID>
        </moduleID>
      </owner>
      <dependency>OWNED</dependency>
    </organization>
    <Property name="btLoopDuration" type="Integer" unit="ms" value="10"/>
  </properties>

  <!-- Input Variables -->
	<ioVariables>
    <Input name="tf" type="tf2_msgs.msg.TFMessage" description = "urdf-based coordinate system topic"/> 
    <Inputs>
      <Input name="navigate_to_pose" type="nav2_msgs.action.NavigateToPose">
        <Input name="pose" type="geometry_msgs.msg.Pose" description="네비게이션 목표 pose"/>
        <description>Navigation goal with target pose and behavior tree specification</description>
      </Input>
      <Input name="navigate_through_poses" type="nav2_msgs.action.NavigateThroughPoses">
        <Input name="poses" type="geometry_msgs.msg.PoseStamped[]" description="여러 경로 지점"/>
      </Input>
    </Inputs>
    <Outputs>
      <Output name="navigation_feedback" type="nav2_msgs.action.NavigateToPose" description="Real-time navigation status and progress">
        <Output name="feedback" type="nav2_msgs.action.NavigateToPose" description="Real-time navigation status and progress"/>
      </Output>
      <Output name="navigation_result" type="nav2_msgs.action.NavigateToPose" description="Final navigation result with success/failure status">
        <Output name="result" type="nav2_msgs.action.NavigateToPose" description="Final navigation result with success/failure status"/>
      </Output>
    </Outputs>
	</ioVariables>
  <services>
		<ServiceXML>
			<ID>00</ID>
			<methodList>
				<Method methodName="navigation_to_pose">
          <argType type="nav2_msgs.srv.NavigateToPose" valueName="Req" inout="IN">
            <argType type="geometry_msgs/PoseStamped" valueName="pose" inout="IN"/>
            <argType type="string " valueName="behavior_tree" inout="IN"/>
            <argType type="float32" valueName="snap_interval" inout="IN"/>
          </argType>
					<retType>uint8</retType>
					<moType>MANDATORY</moType>
					<reqProvType>PROVIDED</reqProvType>
				</Method>
				<Method methodName="navigate_through_poses">
					<argType type="nav2_msgs.srv.NavigateThroughPoses" valueName="Req" inout="IN">
            <argType type="geometry_msgs.msg.PoseStamped[]" valueName="poses" inout="IN"/>
            <argType type="string" valueName="behaviorTree" inout="IN"/>
          </argType>
					<retType>uint8</retType>
					<moType>MANDATORY</moType>
					<reqProvType>PROVIDED</reqProvType>
				</Method>
			</methodList>
			<pvType>VIRTUAL</pvType>
			<moType>MANDATORY</moType>
		</ServiceXML>
  </services>
  <!-- Infrastructure -->
  <Infrastructure>
    <Power>
      <RatedPower>5.0</RatedPower>
      <MaxPower>10.0</MaxPower>
    </Power>
    <NoBuses>1</NoBuses>
    <DataBus>
      <ConnectionType>Ethernet</ConnectionType>
      <TypePhyMac>Ethernet</TypePhyMac>
      <TypeNetTrans>TCP/IP</TypeNetTrans>
      <TypeApp>ROS2</TypeApp>
      <Speed>1000</Speed>
    </DataBus>
    <DbType>None</DbType>
    <IpCode>IP20</IpCode>
    <Middleware>
      <MiddlewareType>ROS2</MiddlewareType>
      <MiddlewareVersion>Humble</MiddlewareVersion>
      <MiddlewareDescription>Robot Operating System 2 for distributed robot software</MiddlewareDescription>
    </Middleware>
  </Infrastructure>
  <safeSecure/>
  <modelling/>
		<exeForm>
			<exeFileURL>rhksgnl00/iic/navigation_module:latest</exeFileURL>
			<shellCmd>docker run -it -d --rm --network=host --privileged rhksgnl00/iic/navigation_module:latest</shellCmd>
		</exeForm>
</Module>
